# 复制为 .env 后填写；npm start 会自动加载，终端已有同名变量优先。
# .env 已被 Git 忽略，请勿将真实密钥填写到此示例文件。

# 运行模式：mock 或 zenmux；命令行 --mode 可覆盖此配置。
AGENT_MODE=mock

# ZenMux：将 AGENT_MODE 改为 zenmux，并填写支持工具调用的完整模型 slug。
ZENMUX_API_KEY=
ZENMUX_MODEL=

# 可选 HTTP/HTTPS 代理；终端已配置时无需重复设置，端口改成自己的。
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1
