{
  "name": "agent-seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start": "npm run build --silent && node --env-file-if-exists=.env dist/src/cli.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "openai": "^6.0.0",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "3.9.9",
    "typescript": "^5.9.0"
  }
}
